<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="container" style="max-width: 800px; margin: 6rem auto 4rem auto;">
  <div style="background: var(--navy-800); border-radius: var(--radius-lg); padding: 2rem; box-shadow: var(--shadow-lg); border: 1px solid rgba(0,0,0,0.05);">
    <h1 style="font-family: var(--font-display); font-size: 2rem; color: var(--white); margin-bottom: 0.5rem;">Ask a Question</h1>
    <p style="color: var(--gray-400); margin-bottom: 2rem;">Get help from the community and verified experts. Be specific and clear.</p>

    <% if (!locals.user) { %>
      <div style="background: rgba(15, 133, 88, 0.1); border: 1px solid var(--indigo); border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1.5rem;">
        <span style="color: var(--gray-300);">You are posting as a <strong>Guest</strong>. <a href="/login" style="color: var(--indigo); font-weight: 600; text-decoration: underline;">Log in</a> or <a href="/register" style="color: var(--indigo); font-weight: 600; text-decoration: underline;">Create an account</a> to post under your own name and track your questions!</span>
      </div>
    <% } %>

    <form action="/questions" method="POST" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 1.5rem;">
      <div>
        <label for="title" style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: var(--gray-300);">Question Title <span style="color:var(--rose);">*</span></label>
        <input type="text" id="title" name="title" required placeholder="e.g., Can I deduct a home office if I also use the room for gaming?" style="width: 100%; padding: 0.85rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--navy-500); background: var(--navy-900); color: var(--white); font-size: 1rem;">
      </div>

      <div>
        <label for="category_id" style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: var(--gray-300);">Category</label>
        <select id="category_id" name="category_id" style="width: 100%; padding: 0.85rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--navy-500); background: var(--navy-900); color: var(--white); font-size: 1rem; appearance: none;">
          <option value="">Select a category (Optional)</option>
          <% categories.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.name %></option>
          <% }); %>
        </select>
      </div>

      <div>
        <label for="description" style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: var(--gray-300);">Description / Details <span style="color:var(--rose);">*</span></label>
        <textarea id="description" name="description" required rows="8" placeholder="Provide as much context as possible. Do not include sensitive personal info like SSN." style="width: 100%; padding: 0.85rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--navy-500); background: var(--navy-900); color: var(--white); font-size: 1rem; resize: vertical;"></textarea>
      </div>

      <div>
        <label for="image" style="display: block; margin-bottom: 0.5rem; font-weight: 500; color: var(--gray-300);">Attach an Image (Optional)</label>
        <input type="file" id="image" name="image" accept="image/*" style="width: 100%; padding: 0.5rem; border-radius: var(--radius-sm); border: 1px dashed var(--navy-500); background: var(--navy-900); color: var(--gray-300);">
        <p style="font-size: 0.8rem; color: var(--gray-500); margin-top: 0.25rem;">Max size: 5MB. Useful for sharing redacted notices or forms.</p>
      </div>

      <div style="display: flex; align-items: center; gap: 0.75rem; background: rgba(0,0,0,0.03); padding: 1rem; border-radius: var(--radius-sm); border: 1px solid rgba(0,0,0,0.05);">
        <input type="checkbox" id="is_anonymous" name="is_anonymous" style="width: 1.2rem; height: 1.2rem;">
        <label for="is_anonymous" style="color: var(--gray-300); font-size: 0.95rem; cursor: pointer;">Post Anonymously</label>
        <span style="font-size: 0.8rem; color: var(--gray-500); margin-left: auto;">Your username will be hidden</span>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1rem;">
        <a href="/community" class="btn btn-outline">Cancel</a>
        <button type="submit" class="btn btn-primary" style="padding: 0.85rem 2rem;">Post Question</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
