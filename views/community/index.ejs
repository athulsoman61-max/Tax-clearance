<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="container" style="margin-top: 6rem; margin-bottom: 4rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-family: var(--font-display); font-size: 2.5rem; color: var(--white); margin-bottom: 0.5rem;">Community</h1>
      <p style="color: var(--gray-400);">Ask questions, share knowledge, and connect with experts.</p>
    </div>
    <a href="/questions/new" class="btn btn-primary" style="padding: 0.75rem 1.5rem; font-size: 1rem; box-shadow: var(--shadow-glow);">❓ Ask a Question</a>
  </div>

  <div class="home-layout">
    <div class="feed-column">
      <div class="article-feed">
        <% if (questions && questions.length > 0) { %>
          <% questions.forEach(q => { %>
            <article class="article-card reveal" style="background: var(--navy-800); border-left: 4px solid var(--indigo); border-radius: var(--radius-md); padding: 1.5rem; display: flex; gap: 1.5rem;">
              <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--radius-sm); padding: 1rem; min-width: 80px; text-align: center;">
                <span style="font-size: 1.5rem; font-weight: 700; color: var(--indigo-400); line-height: 1;"><%= q.answer_count %></span>
                <span style="font-size: 0.75rem; color: var(--gray-400); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.25rem;">Answers</span>
              </div>
              <div style="flex: 1;">
                <div class="article-card-meta" style="margin-bottom: 0.5rem;">
                  <span class="article-card-cat" style="background:<%= q.category_color || '#6366f1' %>22;color:<%= q.category_color || '#6366f1' %>">
                    <%= q.category_name || 'General' %>
                  </span>
                  <span class="article-card-date"><%= new Date(q.created_at).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) %></span>
                  <span class="article-card-read">👁 <%= q.views %> views</span>
                </div>
                <h2 class="article-card-title" style="margin-bottom: 0.5rem; font-size: 1.3rem;">
                  <a href="/question/<%= q.id %>" style="color: var(--white);"><%= q.title %></a>
                </h2>
                <p class="article-card-excerpt" style="font-size: 0.95rem; margin-bottom: 1rem;"><%= q.description.substring(0, 200) %>...</p>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <% if (q.avatar) { %>
                    <img src="<%= q.avatar %>" alt="Avatar" style="width: 24px; height: 24px; border-radius: 50%;">
                  <% } else { %>
                    <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--navy-600); display: flex; align-items: center; justify-content: center; font-size: 12px;">👤</div>
                  <% } %>
                  <span style="font-size: 0.85rem; color: var(--gray-300);">Asked by <strong style="color: var(--white);"><%= q.is_anonymous ? 'Anonymous' : (q.author_name || 'User') %></strong></span>
                </div>
              </div>
            </article>
          <% }); %>
        <% } else { %>
          <div style="padding: 3rem; text-align: center; background: var(--navy-800); border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,0.05);">
            <div style="font-size: 3rem; margin-bottom: 1rem;">📭</div>
            <h3 style="color: var(--white); margin-bottom: 0.5rem;">No questions yet</h3>
            <p style="color: var(--gray-400); margin-bottom: 1.5rem;">Be the first to start a discussion!</p>
            <a href="/questions/new" class="btn btn-primary">Ask a Question</a>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-widget">
        <div class="section-title" style="font-size:1rem;margin-bottom:1rem;">
          <div class="section-title-accent"></div>
          Filter by Topic
        </div>
        <div class="sidebar-cats">
          <% categories.slice(0, 10).forEach(cat => { %>
          <a href="/category/<%= cat.slug %>" class="sidebar-cat">
            <span class="sidebar-cat-icon" style="background:<%= cat.color %>22;color:<%= cat.color %>"><%= cat.icon %></span>
            <span class="sidebar-cat-name"><%= cat.name %></span>
          </a>
          <% }); %>
        </div>
      </div>
      
      <div class="sidebar-widget" style="background:linear-gradient(135deg,rgba(99,102,241,0.12),rgba(168,85,247,0.08));border-color:rgba(99,102,241,0.2);text-align:center;">
        <div style="font-size:2.5rem;margin-bottom:0.75rem;">⭐</div>
        <h3 style="font-family:var(--font-display);font-size:1rem;font-weight:700;margin-bottom:0.5rem;">Expert Answers</h3>
        <p style="font-size:0.82rem;color:var(--gray-400);margin-bottom:1rem;line-height:1.5;">Our community includes verified EAs, CPAs, and Financial Advisors.</p>
        <a href="/experts" class="btn btn-outline" style="width:100%;display:flex;">View Experts Directory</a>
      </div>
    </aside>
  </div>
</div>

<%- include('../partials/footer') %>
