<%
const gaId = settings?.google_analytics_id || '';
const siteName = settings?.site_name || 'Tax Clearance';
const siteUrl = process.env.SITE_URL || 'http://localhost:3000';
const canonicalUrl = canonical_url || (siteUrl + (locals.req ? locals.req.path : '/'));
const ogImg = locals.article?.og_image || locals.article?.featured_image || '/img/og-default.png';
%><!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || siteName %></title>
  <meta name="description" content="<%= description || '' %>">
  <% if (locals.article?.seo_keywords) { %><meta name="keywords" content="<%= locals.article.seo_keywords %>"><% } %>
  <link rel="canonical" href="<%= canonicalUrl %>">

  <!-- Open Graph -->
  <meta property="og:type" content="<%= locals.article ? 'article' : 'website' %>">
  <meta property="og:title" content="<%= title || siteName %>">
  <meta property="og:description" content="<%= description || '' %>">
  <meta property="og:image" content="<%= siteUrl %><%= ogImg %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:site_name" content="<%= siteName %>">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="<%= settings?.twitter_handle || '' %>">
  <meta name="twitter:title" content="<%= title || siteName %>">
  <meta name="twitter:description" content="<%= description || '' %>">
  <meta name="twitter:image" content="<%= siteUrl %><%= ogImg %>">

  <!-- JSON-LD Schema -->
  <% if (locals.article) { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "<%= locals.article.title?.replace(/"/g, '\\"') %>",
    "description": "<%= (locals.article.excerpt || '').replace(/"/g, '\\"') %>",
    "author": { "@type": "Person", "name": "<%= settings?.ea_name || 'Tax Clearance EA' %>" },
    "publisher": { "@type": "Organization", "name": "<%= siteName %>", "url": "<%= siteUrl %>" },
    "datePublished": "<%= locals.article.publish_date || locals.article.created_at %>",
    "dateModified": "<%= locals.article.updated_at %>",
    "url": "<%= siteUrl %>/article/<%= locals.article.slug %>",
    "image": "<%= siteUrl %><%= locals.article.featured_image || '' %>"
  }
  </script>
  <% } %>

  <!-- Styles -->
  <link rel="stylesheet" href="/css/main.css">
  <% if (locals.extraCss) { %><link rel="stylesheet" href="/css/<%= locals.extraCss %>"><% } %>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">

  <% if (gaId) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= gaId %>"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','<%= gaId %>');</script>
  <% } %>
</head>
<body>

<!-- Navigation -->
<nav class="navbar" id="navbar">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <div class="nav-logo-icon">⚖️</div>
      <span class="nav-logo-text"><%= siteName.split(' ')[0] %> <span><%= siteName.split(' ').slice(1).join(' ') %></span></span>
    </a>

    <div class="nav-links">
      <a href="/" class="<%= page === 'home' ? 'active' : '' %>">Home</a>
      <a href="/category/tax-deductions">Deductions</a>
      <a href="/category/irs-updates">IRS Updates</a>
      <a href="/category/small-business-taxes">Business</a>
      <a href="/category/tax-planning">Planning</a>
      <a href="/about" class="<%= page === 'about' ? 'active' : '' %>">About EA</a>
    </div>

    <div class="nav-right">
      <button class="nav-search-btn" id="searchBtn" aria-label="Search">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </button>
      <a href="/contact" class="btn-ea">Ask an EA →</a>
      <button class="nav-toggle" id="navToggle" aria-label="Menu">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu -->
<div class="mobile-menu" id="mobileMenu">
  <a href="/">🏠 Home</a>
  <a href="/category/tax-deductions">💰 Tax Deductions</a>
  <a href="/category/tax-credits">✅ Tax Credits</a>
  <a href="/category/irs-updates">📢 IRS Updates</a>
  <a href="/category/small-business-taxes">🏢 Small Business</a>
  <a href="/category/self-employed-taxes">💼 Self-Employed</a>
  <a href="/category/tax-planning">📊 Tax Planning</a>
  <a href="/category/crypto-tax">₿ Crypto Tax</a>
  <a href="/about">👤 About EA</a>
  <a href="/contact" style="color: var(--indigo-400);">📞 Consultation</a>
</div>

<!-- Search Overlay -->
<div class="search-overlay" id="searchOverlay">
  <div class="search-overlay-inner">
    <div class="search-overlay-input-wrap">
      <input type="text" class="search-overlay-input" id="searchInput" placeholder="Search tax topics, deductions, credits..." autocomplete="off">
      <button class="search-close" id="searchClose" aria-label="Close search">✕</button>
    </div>
    <div class="search-results-live" id="searchResultsLive" style="display:none;"></div>
  </div>
</div>

<!-- Toast Container -->
<div class="toast-container" id="toastContainer"></div>

<!-- Main Content -->
<main class="pt-nav">
  <%- body %>
</main>

<!-- Footer -->
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="nav-logo">
          <div class="nav-logo-icon">⚖️</div>
          <span><%= siteName.split(' ')[0] %> <span style="color:var(--amber)"><%= siteName.split(' ').slice(1).join(' ') %></span></span>
        </a>
        <p class="footer-desc"><%= settings?.site_description || 'Free US tax education by an Enrolled Agent.' %></p>
        <div class="footer-social">
          <% if (settings?.twitter_handle) { %><a href="https://twitter.com/<%= settings.twitter_handle.replace('@','') %>" target="_blank" rel="noopener" aria-label="Twitter">𝕏</a><% } %>
          <% if (settings?.facebook_url) { %><a href="<%= settings.facebook_url %>" target="_blank" rel="noopener" aria-label="Facebook">f</a><% } %>
          <% if (settings?.linkedin_url) { %><a href="<%= settings.linkedin_url %>" target="_blank" rel="noopener" aria-label="LinkedIn">in</a><% } %>
        </div>
      </div>

      <div>
        <div class="footer-col-title">Categories</div>
        <div class="footer-links">
          <a href="/category/tax-deductions">💰 Tax Deductions</a>
          <a href="/category/tax-credits">✅ Tax Credits</a>
          <a href="/category/irs-updates">📢 IRS Updates</a>
          <a href="/category/small-business-taxes">🏢 Small Business</a>
          <a href="/category/self-employed-taxes">💼 Self-Employed</a>
          <a href="/category/crypto-tax">₿ Crypto Tax</a>
        </div>
      </div>

      <div>
        <div class="footer-col-title">More Topics</div>
        <div class="footer-links">
          <a href="/category/tax-planning">📊 Tax Planning</a>
          <a href="/category/international-tax">🌍 International Tax</a>
          <a href="/category/state-taxes">🗺️ State Taxes</a>
          <a href="/category/tax-filing-tips">📝 Filing Tips</a>
          <a href="/category/tax-deadlines">📅 Deadlines</a>
          <a href="/category/tax-relief-programs">🛡️ Tax Relief</a>
        </div>
      </div>

      <div>
        <div class="footer-col-title">Enrolled Agent</div>
        <div class="footer-links">
          <a href="/about">About <%= settings?.ea_name || 'Our EA' %></a>
          <a href="/contact">Book Consultation</a>
          <a href="/contact">Ask a Question</a>
          <a href="/sitemap.xml" target="_blank">Sitemap</a>
          <a href="/robots.txt" target="_blank">Robots.txt</a>
        </div>

        <div style="margin-top: 1.5rem;">
          <div class="footer-col-title">Newsletter</div>
          <form class="newsletter-form" id="footerNewsletter" style="flex-direction: column; max-width: 100%;">
            <input type="email" class="newsletter-input" placeholder="your@email.com" name="email" required>
            <button type="submit" class="btn btn-primary btn-sm" style="margin-top: 0.5rem;">Subscribe Free</button>
          </form>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-copy"><%= settings?.footer_text || `© ${new Date().getFullYear()} ${siteName}. All rights reserved.` %></div>
      <div class="footer-disclaimer">Educational content only — not legal or financial advice. Always consult a qualified tax professional for your specific situation.</div>
    </div>
  </div>
</footer>

<script src="/js/main.js"></script>
<% if (locals.extraJs) { %><script src="/js/<%= locals.extraJs %>"></script><% } %>
</body>
</html>
