    <div class="ticker-items" style="flex:1;overflow:hidden;min-width:0;">
      <div class="ticker-track">
        <% irsUpdates.forEach(u => { %><a href="/article/<%= u.slug %>" class="ticker-item">⚡ <%= u.title %></a><% }); %>
        <% irsUpdates.forEach(u => { %><a href="/article/<%= u.slug %>" class="ticker-item">⚡ <%= u.title %></a><% }); %>
      </div>
    </div>
  </div>
  <% } %>

  <div style="margin-top:1.5rem;marg<!-- ② "Hottest News" Swipe Carousel — FIRST on mobile, flush under navbar -->
<div class="container order-mobile-2" style="margin-top:1rem;margin-bottom:2rem;">

  <div class="glance-section" id="articleCarousel" style="background:rgba(15,23,42,0.6);border:1px solid rgba(255,255,255,0.08);padding:2rem;border-radius:var(--radius-lg);">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:1.2rem;flex-wrap:wrap;gap:0.5rem;">
      <h2 style="font-family:var(--font-display);font-size:1.5rem;font-weight:800;margin:0;color:var(--white);display:flex;align-items:center;gap:0.5rem;">
        <span style="display:inline-block;width:8px;height:24px;background:var(--amber);border-radius:4px;"></span> 🔥 Most Read &amp; Trending
      </h2>
      <a href="/articles" style="color:var(--indigo-400);font-weight:700;font-size:0.9rem;">View All →</a>
    </div>
    <div class="swipe-hint">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      Swipe to explore more
    </div>
    <div class="carousel-wrapper" id="newsCarouselWrapper">
      <button class="scroll-btn prev hidden" id="newsPrev" aria-label="Previous">&#8249;</button>
      <button class="scroll-btn next" id="newsNext" aria-label="Next">&#8250;</button>
      <div class="glance-track" id="newsTrack">
        <% articles.slice(0,8).forEach((article, i) => { %>
          <div class="glance-card">
            <a href="/article/<%= article.slug %>" style="display:block;position:relative;">
              <div class="glance-card-img-wrapper">
                <% if (article.featured_image) { %>
                  <% const imgPath = article.featured_image.startsWith('/') || article.featured_image.startsWith('http') ? article.featured_image : '/images/' + article.featured_image; %>
                  <img src="<%= imgPath %>" class="glance-card-img" alt="<%= article.title %>" loading="lazy"
                    onerror="this.style.display='none';this.parentElement.innerHTML+='<div style=\'display:flex;align-items:center;justify-content:center;height:100%;font-size:3rem;\'><%= article.category_icon || "📋" %></div>'">
                <% } else { %>
                  <div style="display:flex;align-items:center;justify-content:center;height:100%;font-size:3rem;"><%= article.category_icon || '📋' %></div>
                <% } %>
                <div class="glance-card-num"><%= (i+1).toString().padStart(2,'0') %></div>
              </div>
            </a>
            <div class="glance-card-body">
              <div style="margin-bottom:0.5rem;">
                <span style="color:<%= article.category_color %>;font-size:0.72rem;font-weight:700;background:<%= article.category_color %>22;padding:0.2rem 0.5rem;border-radius:4px;"><%= article.category_name || 'General' %></span>
              </div>
              <h3 style="font-size:1rem;line-height:1.4;margin:0 0 0.5rem 0;flex:1;">
                <a href="/article/<%= article.slug %>" style="color:var(--white);text-decoration:none;"><%= article.title %></a>
              </h3>
              <div style="font-size:0.78rem;color:var(--gray-400);">
                <%= new Date(article.publish_date || article.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %>
                &nbsp;·&nbsp; <%= article.reading_time || Math.max(2,Math.ceil((article.content||'').length/1000)) %> min read
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
    <div class="scroll-dots" id="newsDots">
      <% articles.slice(0,8).forEach((_,i) => { %>
        <div class="scroll-dot <%= i===0?'active':'' %>" data-track="newsTrack" data-index="<%= i %>"></div>
      <% }); %>
    </div>
  </div>
</div>

<!-- Category pills row — mobile only, sits between carousel and feed -->
<div class="mobile-topic-scroll-below" style="display:none;">
  <a href="/" class="cat-pill">All</a>
  <% categories.slice(0,8).forEach(cat => { %>
  <a href="/category/<%= cat.slug %>" class="cat-pill"><%= cat.name %></a>
  <% }); %>
</div>


<!-- ③ Latest Articles Feed (vertical scroll) -->
<div class="container order-mobile-3" style="margin-top:1.5rem;">
  <div class="home-layout">
    <main class="article-feed">
      <div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,0.1);padding-bottom:0.8rem;flex-wrap:wrap;gap:0.5rem;">
        <h2 style="font-family:var(--font-display);font-size:1.6rem;font-weight:800;color:var(--white);margin:0;display:flex;align-items:center;gap:0.6rem;">
          <span style="display:inline-block;width:8px;height:26px;background:var(--indigo);border-radius:4px;box-shadow:0 0 12px var(--indigo);"></span>
          Latest Articles
        </h2>
        <span style="font-size:0.85rem;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:var(--gray-300);padding:0.3rem 0.8rem;border-radius:var(--radius-full);font-weight:600;">
          <%= articles.length %> of <strong style="color:var(--indigo-400);"><%= totalArticles || '85+' %></strong>
        </span>
      </div>

      <% if (articles && articles.length > 0) { %>
        <% articles.forEach(article => { %>
        <% const feedImg = article.featured_image ? (article.featured_image.startsWith('/') || article.featured_image.startsWith('http') ? article.featured_image : '/images/' + article.featured_image) : null; %>
        <article class="article-card reveal" style="background:var(--navy-800);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-md);border:1px solid rgba(255,255,255,0.1);transition:transform 0.25s ease,border-color 0.25s ease;display:flex;flex-direction:column;">
          <% if (feedImg) { %>
          <a href="/article/<%= article.slug %>" class="article-card-img" style="display:block;height:240px;overflow:hidden;position:relative;flex-shrink:0;background:var(--navy-700);">
            <img src="<%= feedImg %>" alt="<%= article.title %>" loading="lazy" style="width:100%;height:100%;object-fit:cover;transition:transform 0.4s ease;"
              onerror="this.style.display='none';this.parentElement.innerHTML+='<div style=\'display:flex;align-items:center;justify-content:center;height:100%;font-size:3.5rem;\'><%= article.category_icon || "📋" %></div>'">
            <div class="article-card-cat-badge" style="position:absolute;top:1rem;left:1rem;z-index:2;">
              <span style="background:<%= article.category_color || '#6366f1' %>ee;color:#fff;font-size:0.75rem;padding:0.3rem 0.8rem;border-radius:var(--radius-full);font-weight:800;text-transform:uppercase;letter-spacing:0.5px;box-shadow:0 2px 8px rgba(0,0,0,0.4);">
                <%= article.category_name || 'General Tax' %>
              </span>
            </div>
          </a>
          <% } %>
          <div class="article-card-body" style="padding:1.5rem;flex:1;display:flex;flex-direction:column;justify-content:space-between;">
            <div>
              <div class="article-card-meta" style="margin-bottom:0.6rem;display:flex;align-items:center;gap:0.8rem;font-size:0.8rem;color:var(--gray-400);">
                <span>📅 <%= new Date(article.publish_date || article.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></span>
                <span class="meta-separator">•</span>
                <span class="meta-time">⏱️ <%= article.reading_time || Math.max(2,Math.ceil((article.content||'').length/1000)) %> min read</span>
                <% if (article.author_name) { %>
                <span class="meta-separator">•</span>
                <span class="meta-author">✍️ by <strong style="color:var(--gray-300);"><%= article.author_name %></strong></span>
                <% } %>
              </div>
              <h2 style="font-size:1.35rem;font-weight:800;line-height:1.35;margin:0 0 0.75rem 0;">
                <a href="/article/<%= article.slug %>" style="color:var(--white);text-decoration:none;transition:color 0.2s;"><%= article.title %></a>
              </h2>
              <% if (article.excerpt) { %>
              <p class="article-card-excerpt" style="font-size:0.95rem;color:var(--gray-300);line-height:1.65;margin:0 0 1.25rem 0;"><%= article.excerpt %></p>
              <% } %>
            </div>
            <div class="article-card-footer">
              <a href="/article/<%= article.slug %>" class="btn btn-sm" style="background:rgba(99,102,241,0.15);border:1px solid var(--indigo);color:var(--indigo-400);font-weight:700;padding:0.5rem 1.2rem;border-radius:var(--radius-full);display:inline-flex;align-items:center;gap:0.4rem;">
                <span>Read Article</span> →
              </a>
            </div>
          </div>
        </article>
        <% }); %>
      <% } else { %>
        <p style="color:var(--gray-400);text-align:center;padding:3rem;">No articles yet. Check back soon!</p>
      <% } %>

      <div style="margin:1.5rem 0;text-align:center;background:linear-gradient(135deg,rgba(30,41,59,0.9),rgba(15,23,42,0.95));border:1px solid rgba(99,102,241,0.4);border-radius:var(--radius-lg);padding:3rem 2rem;box-shadow:var(--shadow-lg);">
        <div style="font-size:2.5rem;margin-bottom:0.5rem;">📚</div>
        <h3 style="font-family:var(--font-display);font-size:1.6rem;font-weight:800;color:var(--white);margin:0 0 0.6rem 0;">Explore <%= totalArticles || '85' %>+ Tax Guides</h3>
        <p style="color:var(--gray-300);font-size:1rem;margin:0 auto 1.8rem auto;max-width:560px;line-height:1.6;">
          IRS updates, deductions, crypto tax, LLC, retirement, and more.
        </p>
        <a href="/articles" class="btn btn-primary" style="padding:1rem 3.2rem;font-size:1.1rem;font-weight:800;border-radius:var(--radius-full);display:inline-flex;align-items:center;gap:0.8rem;">
          <span>Browse Full Archive (<%= totalArticles %>+ Articles)</span> →
        </a>
      </div>
    </main>

    <!-- Sidebar (desktop only) -->
    <aside class="sidebar">
      <div class="sidebar-widget reveal newsletter-widget">
        <div class="newsletter-icon">📬</div>
        <h3 class="newsletter-title">Free Tax Intelligence</h3>
        <p class="newsletter-sub">Get breaking IRS tax changes and weekly money-saving tips delivered to your inbox.</p>
        <form class="newsletter-form-vertical" id="sidebarNewsletter">
          <input type="text" name="name" placeholder="Your name" class="newsletter-input" style="margin-bottom:0.5rem;">
          <input type="email" name="email" placeholder="your@email.com" class="newsletter-input" required>
          <button type="submit" class="btn btn-primary" style="width:100%;margin-top:0.5rem;font-weight:700;">Subscribe Free</button>
          <p style="font-size:0.72rem;color:var(--gray-500);text-align:center;margin-top:0.5rem;">No spam. Unsubscribe anytime.</p>
        </form>
      </div>
      <div class="sidebar-widget reveal">
        <div class="section-title" style="font-size:1.1rem;margin-bottom:1.2rem;font-weight:800;">
          <div class="section-title-accent"></div>Article Categories
        </div>
        <div class="sidebar-cats">
          <% categories.forEach(cat => { %>
          <a href="/category/<%= cat.slug %>" class="sidebar-cat">
            <span class="sidebar-cat-icon" style="background:<%= cat.color %>22;color:<%= cat.color %>"><%= cat.icon %></span>
            <span class="sidebar-cat-name"><%= cat.name %></span>
            <span class="sidebar-cat-count"><%= cat.article_count || 0 %></span>
          </a>
          <% }); %>
          <a href="/articles" class="sidebar-cat" style="margin-top:0.5rem;background:rgba(99,102,241,0.1);border-color:rgba(99,102,241,0.3);">
            <span class="sidebar-cat-icon" style="background:var(--indigo);color:#fff;">📚</span>
            <span class="sidebar-cat-name" style="color:var(--indigo-400);">All Published Articles</span>
            <span class="sidebar-cat-count" style="background:var(--indigo);color:#fff;"><%= totalArticles || '85+' %></span>
          </a>
        </div>
      </div>
    </aside>
  </div>
</div>

<!-- ④ Community Q&A (hidden on mobile) -->
<div class="container order-mobile-4" style="margin-top:1rem;margin-bottom:2rem;">
  <div class="glance-section">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:0.8rem;flex-wrap:wrap;gap:0.5rem;">
      <h2 style="font-size:1.4rem;font-weight:800;margin:0;color:var(--white);display:flex;align-items:center;gap:0.5rem;">
        <span style="display:inline-block;width:8px;height:22px;background:var(--indigo);border-radius:4px;"></span> Reader Questions &amp; Community
      </h2>
      <a href="/community" style="color:var(--indigo-400);font-weight:600;font-size:0.85rem;">Browse Q&amp;A →</a>
    </div>
    <div class="swipe-hint">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      Swipe to browse Q&amp;A
    </div>
    <div class="carousel-wrapper" id="discCarouselWrapper">
      <button class="scroll-btn prev hidden" id="discPrev" aria-label="Previous">&#8249;</button>
      <button class="scroll-btn next" id="discNext" aria-label="Next">&#8250;</button>
      <div class="glance-track" id="discTrack">
        <div class="glance-community-card" style="justify-content:center;align-items:center;text-align:center;border-left:4px dashed var(--indigo-400);background:rgba(99,102,241,0.05);">
          <div style="font-size:2.2rem;margin-bottom:0.5rem;">💬</div>
          <h3 style="font-size:1.1rem;color:var(--white);margin:0;font-weight:800;">Have a tax question?</h3>
          <p style="font-size:0.85rem;color:var(--gray-300);margin:0.5rem 0 1.2rem 0;">Submit your question to our Enrolled Agents and community members.</p>
          <a href="/questions/new" class="btn btn-primary btn-sm" style="width:100%;padding:0.6rem 1rem;font-weight:700;">Ask a Question</a>
        </div>
        <% if (recentQuestions && recentQuestions.length > 0) { %>
          <% recentQuestions.slice(0,6).forEach(q => { %>
            <div class="glance-community-card">
              <div style="display:flex;gap:1rem;align-items:flex-start;">
                <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(0,0,0,0.15);border:1px solid rgba(255,255,255,0.08);border-radius:var(--radius-sm);padding:0.5rem;min-width:50px;">
                  <span style="font-size:1.15rem;font-weight:800;color:var(--indigo-400);line-height:1;"><%= q.answer_count %></span>
                  <span style="font-size:0.62rem;color:var(--gray-400);text-transform:uppercase;font-weight:700;margin-top:0.25rem;">Ans</span>
                </div>
                <div style="flex:1;min-width:0;">
                  <div style="margin-bottom:0.4rem;">
                    <span style="background:<%= q.category_color || '#6366f1' %>22;color:<%= q.category_color || '#6366f1' %>;padding:0.18rem 0.5rem;font-size:0.7rem;border-radius:4px;font-weight:700;"><%= q.category_name || 'General Tax' %></span>
                  </div>
                  <h3 style="font-size:0.98rem;line-height:1.4;margin:0 0 0.5rem 0;font-weight:700;">
                    <a href="/question/<%= q.id %>" style="color:var(--white);text-decoration:none;"><%= q.title %></a>
                  </h3>
                  <div style="font-size:0.78rem;color:var(--gray-400);">asked by <%= q.is_anonymous ? 'Anonymous Reader' : (q.author_name || 'Reader') %></div>
                </div>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
    <div class="scroll-dots" id="discDots">
      <div class="scroll-dot active" data-track="discTrack" data-index="0"></div>
      <% if (recentQuestions && recentQuestions.length > 0) { %>
        <% recentQuestions.slice(0,6).forEach((_,i) => { %>
          <div class="scroll-dot" data-track="discTrack" data-index="<%= i+1 %>"></div>
        <% }); %>
      <% } %>
    </div>
  </div>
</div>

