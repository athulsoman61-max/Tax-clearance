<%- include('partials/head') %>
<%- include('partials/navbar') %>

<!-- New Community Hero Section -->
<section class="hero-section" style="background: var(--gradient-hero); padding-top: calc(var(--nav-height) + 2rem); padding-bottom: 2rem; text-align: center;">
  <div class="container" style="max-width: 800px; margin: 0 auto;">
    <h1 class="hero-title" style="font-size: clamp(2rem, 4vw, 3rem); font-family: var(--font-display); font-weight: 800; color: var(--white); margin-bottom: 1rem; line-height: 1.1;">
      Clear Your Tax and Finance Doubts
    </h1>
    <p class="hero-excerpt" style="font-size: 1rem; color: var(--gray-300); margin-bottom: 1.5rem; line-height: 1.5;">
      Read expert articles, ask questions, join discussions, and get answers from verified professionals.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/questions/new" class="btn btn-primary" style="box-shadow: var(--shadow-glow);">❓ Ask a Question</a>
      <a href="#articleFeed" class="btn btn-secondary" style="background: rgba(0,0,0,0.1); border: 1px solid rgba(0,0,0,0.2); color: var(--white);">📚 Explore Articles</a>
    </div>
  </div>
</section>

<!-- Action Cards (What Can You Do Here?) -->
<div class="container" style="margin-top: -1rem; position: relative; z-index: 10;">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
    <!-- Card 1 -->
    <a href="#articleCarousel" style="background: var(--navy-700); padding: 1rem; border-radius: var(--radius-md); box-shadow: var(--shadow-md); border: 1px solid rgba(0,0,0,0.05); display: flex; align-items: center; gap: 1rem;">
      <img src="/images/card_read_articles.png" alt="Read Articles" style="width: 50px; height: 50px; object-fit: contain;">
      <div style="text-align: left;">
        <h3 style="color: var(--white); font-size: 1rem; margin-bottom: 0.25rem;">Read Articles</h3>
        <p style="color: var(--gray-400); font-size: 0.75rem; margin: 0;">Tax & finance guides.</p>
      </div>
    </a>
    <!-- Card 2 -->
    <a href="/questions/new" style="background: var(--navy-700); padding: 1rem; border-radius: var(--radius-md); box-shadow: var(--shadow-md); border: 1px solid rgba(0,0,0,0.05); display: flex; align-items: center; gap: 1rem;">
      <img src="/images/card_ask_questions.png" alt="Ask Questions" style="width: 50px; height: 50px; object-fit: contain;">
      <div style="text-align: left;">
        <h3 style="color: var(--white); font-size: 1rem; margin-bottom: 0.25rem;">Ask Questions</h3>
        <p style="color: var(--gray-400); font-size: 0.75rem; margin: 0;">Get expert answers.</p>
      </div>
    </a>
    <!-- Card 3 -->
    <a href="/community" style="background: var(--navy-700); padding: 1rem; border-radius: var(--radius-md); box-shadow: var(--shadow-md); border: 1px solid rgba(0,0,0,0.05); display: flex; align-items: center; gap: 1rem;">
      <img src="/images/card_join_discussions.png" alt="Join Discussions" style="width: 50px; height: 50px; object-fit: contain;">
      <div style="text-align: left;">
        <h3 style="color: var(--white); font-size: 1rem; margin-bottom: 0.25rem;">Discussions</h3>
        <p style="color: var(--gray-400); font-size: 0.75rem; margin: 0;">Wealth building tips.</p>
      </div>
    </a>
    <!-- Card 4 -->
    <a href="/experts" style="background: var(--navy-700); padding: 1rem; border-radius: var(--radius-md); box-shadow: var(--shadow-md); border: 1px solid rgba(0,0,0,0.05); display: flex; align-items: center; gap: 1rem;">
      <img src="/images/card_learn_experts.png" alt="Learn From Experts" style="width: 50px; height: 50px; object-fit: contain;">
      <div style="text-align: left;">
        <h3 style="color: var(--white); font-size: 1rem; margin-bottom: 0.25rem;">Experts</h3>
        <p style="color: var(--gray-400); font-size: 0.75rem; margin: 0;">Verified EAs & CPAs.</p>
      </div>
    </a>
  </div>
</div>

<!-- IRS Updates Ticker -->
<% if (irsUpdates && irsUpdates.length > 0) { %>
<div class="container" style="margin-top: 1.5rem;">
  <div class="irs-ticker">
    <span class="ticker-label">🔴 IRS</span>
    <div class="ticker-items">
      <div class="ticker-track">
        <% irsUpdates.forEach(u => { %>
        <a href="/article/<%= u.slug %>" class="ticker-item"><%= u.title %></a>
        <% }); %>
        <% irsUpdates.forEach(u => { %>
        <a href="/article/<%= u.slug %>" class="ticker-item"><%= u.title %></a>
        <% }); %>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Category Pills -->
<div class="container" style="margin-top:2rem;">
  <div class="cat-pills">
    <a href="/" class="cat-pill <%= !locals.activeCat ? 'active' : '' %>">All</a>
    <% categories.slice(0, 10).forEach(cat => { %>
    <a href="/category/<%= cat.slug %>" class="cat-pill" style="--cat-color: <%= cat.color %>">
      <%= cat.icon %> <%= cat.name %>
    </a>
    <% }); %>
  </div>
</div>


<!-- Main Layout: 2 Columns -->
<div class="container home-layout" style="margin-top: 2.5rem;">

  <!-- Left Column: Article Feed -->
  <div class="feed-column">
    <div class="section-header" style="margin-bottom: 1.5rem;" id="articleCarousel">
      <div class="section-title">
        <div class="section-title-accent"></div>
        Latest Articles
      </div>
      <a href="/category/tax-deductions" class="text-muted" style="font-size:0.85rem; text-decoration: underline;">View All</a>
    </div>

    <div style="display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 3rem;">
      <% articles.slice(0, 8).forEach((article, i) => { %>
      <article class="article-card reveal" style="display: flex; gap: 1rem; align-items: stretch; background: var(--navy-800); border-radius: var(--radius-md); padding: 1rem; box-shadow: var(--shadow-sm);">
        <a href="/article/<%= article.slug %>" style="width: 120px; flex-shrink: 0;">
          <div class="article-card-img" style="height: 100%; border-radius: var(--radius-sm); overflow: hidden;">
            <% if (article.featured_image) { %>
            <img src="<%= article.featured_image %>" alt="<%= article.title %>" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;">
            <% } else { %>
            <div class="article-card-placeholder" style="height: 100%;"><%= article.category_icon || '📋' %></div>
            <% } %>
          </div>
        </a>
        <div style="flex: 1; display: flex; flex-direction: column; justify-content: center;">
          <span style="color:<%= article.category_color %>; font-size: 0.75rem; font-weight: 600;"><%= article.category_name || 'General' %></span>
          <h3 style="font-size: 1.1rem; line-height: 1.3; margin: 0.25rem 0;"><a href="/article/<%= article.slug %>" style="color: var(--white);"><%= article.title %></a></h3>
          <span style="font-size: 0.8rem; color: var(--gray-400);"><%= new Date(article.publish_date || article.created_at).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) %></span>
        </div>
      </article>
      <% }); %>
    </div>
  </div>

  <!-- Right Column: Community Questions -->
  <div class="feed-column">
    <div class="section-header" style="margin-bottom: 1.5rem;">
      <div class="section-title">
        <div class="section-title-accent" style="background: var(--indigo);"></div>
        Community Discussions
      </div>
      <a href="/community" class="text-muted" style="font-size:0.85rem; text-decoration: underline;">View All</a>
    </div>

    <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 3rem;">
      <% if (recentQuestions && recentQuestions.length > 0) { %>
        <% recentQuestions.slice(0, 6).forEach(q => { %>
          <article class="article-card reveal" style="background: var(--navy-800); border-left: 4px solid var(--indigo); border-radius: var(--radius-md); padding: 1.25rem;">
            <div style="display: flex; align-items: flex-start; gap: 1rem;">
              <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(0,0,0,0.03); border: 1px solid rgba(0,0,0,0.08); border-radius: var(--radius-sm); padding: 0.5rem; min-width: 50px; text-align: center;">
                <span style="font-size: 1.1rem; font-weight: 700; color: var(--indigo-400); line-height: 1;"><%= q.answer_count %></span>
                <span style="font-size: 0.6rem; color: var(--gray-400); text-transform: uppercase; margin-top: 0.25rem;">Answers</span>
              </div>
              <div style="flex: 1;">
                <div class="article-card-meta" style="margin-bottom: 0.25rem;">
                  <span class="article-card-cat" style="background:<%= q.category_color || '#6366f1' %>22;color:<%= q.category_color || '#6366f1' %>; padding: 0.15rem 0.5rem; font-size: 0.7rem;">
                    <%= q.category_name || 'General' %>
                  </span>
                  <span class="article-card-date" style="font-size: 0.8rem;">by <%= q.is_anonymous ? 'Anonymous' : (q.author_name || 'User') %></span>
                </div>
                <h2 class="article-card-title" style="margin-bottom: 0.25rem; font-size: 1.05rem;">
                  <a href="/question/<%= q.id %>" style="color: var(--white);"><%= q.title %></a>
                </h2>
              </div>
            </div>
          </article>
        <% }); %>
      <% } else { %>
        <div style="padding: 2rem; text-align: center; background: var(--navy-800); border-radius: var(--radius-md); border: 1px dashed rgba(0,0,0,0.1);">
          <p style="color: var(--gray-400);">No questions yet. Be the first to ask!</p>
        </div>
      <% } %>
      <div style="text-align: center; margin-top: 1rem;">
        <a href="/questions/new" class="btn btn-primary" style="width: 100%;">❓ Ask a Question</a>
      </div>
    </div>
    
    <!-- EA CTA (Moved under community questions) -->
    <div class="ea-cta-banner reveal" style="margin-bottom:1.5rem;">
      <div class="ea-cta-avatar">⚖️</div>
      <div class="ea-cta-content">
        <div class="ea-cta-title">Need Tax Help?</div>
        <div class="ea-cta-sub"><%= settings?.ea_name || 'Our Enrolled Agent' %> is here to help with your tax questions.</div>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
          <a href="/contact" class="btn btn-primary btn-sm">Book Consultation</a>
        </div>
      </div>
    </div>

  </div>

</div>
<!-- Newsletter -->
    <div class="sidebar-widget reveal newsletter-widget">
      <div class="newsletter-icon">📬</div>
      <h3 class="newsletter-title">Free Tax Updates</h3>
      <p class="newsletter-sub">Get the latest IRS changes and tax tips delivered to your inbox — free.</p>
      <form class="newsletter-form-vertical" id="sidebarNewsletter">
        <input type="text" name="name" placeholder="Your name" class="newsletter-input" style="margin-bottom:0.5rem;">
        <input type="email" name="email" placeholder="your@email.com" class="newsletter-input" required>
        <button type="submit" class="btn btn-primary" style="width:100%;margin-top:0.5rem;">Subscribe Free</button>
        <p style="font-size:0.72rem;color:var(--gray-600);text-align:center;margin-top:0.5rem;">No spam. Unsubscribe anytime.</p>
      </form>
    </div>

    <!-- Categories -->
    <div class="sidebar-widget reveal">
      <div class="section-title" style="font-size:1rem;margin-bottom:1rem;">
        <div class="section-title-accent"></div>
        Browse Categories
      </div>
      <div class="sidebar-cats">
        <% categories.forEach(cat => { %>
        <a href="/category/<%= cat.slug %>" class="sidebar-cat">
          <span class="sidebar-cat-icon" style="background:<%= cat.color %>22;color:<%= cat.color %>"><%= cat.icon %></span>
          <span class="sidebar-cat-name"><%= cat.name %></span>
          <span class="sidebar-cat-count"><%= cat.article_count || 0 %></span>
        </a>
        <% }); %>
      </div>
    </div>

  </aside>
</div>

<style>
/* Home page specific styles */
.hero-section {
  position: relative;
  min-height: 75vh;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  padding-top: var(--nav-height);
}
.hero-bg {
  position: absolute;
  inset: 0;
  background: var(--gradient-hero);
  background-size: cover;
  background-position: center;
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(10,14,26,0.97) 0%, rgba(10,14,26,0.6) 50%, rgba(10,14,26,0.3) 100%);
}
.hero-content {
  position: relative;
  z-index: 1;
  padding-bottom: 4rem;
  max-width: 800px;
}
.hero-badge {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1rem;
}
.hero-featured-label {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--amber);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.hero-title {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 4vw, 3rem);
  font-weight: 800;
  line-height: 1.15;
  margin-bottom: 1rem;
  color: var(--white);
}
.hero-excerpt {
  font-size: 1rem;
  color: var(--gray-300);
  line-height: 1.7;
  margin-bottom: 1.25rem;
  max-width: 600px;
}
.hero-meta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.85rem;
  color: var(--gray-400);
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}
.hero-dot { color: var(--gray-600); }
.hero-cta { font-size: 1rem; padding: 0.75rem 2rem; }

.cat-pills {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  align-items: center;
}
.cat-pill {
  padding: 0.4rem 0.9rem;
  border-radius: var(--radius-full);
  font-size: 0.8rem;
  font-weight: 500;
  background: rgba(0,0,0,0.05);
  border: 1px solid rgba(0,0,0,0.08);
  color: var(--gray-300);
  transition: var(--transition);
  white-space: nowrap;
}
.cat-pill:hover, .cat-pill.active {
  background: var(--indigo-light);
  border-color: var(--indigo);
  color: var(--indigo-400);
}

.home-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2.5rem;
  align-items: start;
  padding-bottom: 4rem;
}

.article-feed {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.sidebar { position: sticky; top: calc(var(--nav-height) + 1.5rem); display: flex; flex-direction: column; gap: 1.5rem; }

.sidebar-widget {
  background: var(--navy-700);
  border: 1px solid rgba(0,0,0,0.07);
  border-radius: var(--radius-lg);
  padding: 1.5rem;
}

.newsletter-widget {
  background: linear-gradient(135deg, rgba(99,102,241,0.12) 0%, rgba(168,85,247,0.08) 100%);
  border-color: rgba(99,102,241,0.2);
  text-align: center;
}
.newsletter-icon { font-size: 2rem; margin-bottom: 0.5rem; }
.newsletter-title { font-family: var(--font-display); font-size: 1rem; font-weight: 700; margin-bottom: 0.4rem; }
.newsletter-sub { font-size: 0.82rem; color: var(--gray-400); margin-bottom: 1rem; line-height: 1.5; }
.newsletter-form-vertical { display: flex; flex-direction: column; }

.trending-list { display: flex; flex-direction: column; gap: 0; }
.trending-item {
  display: flex;
  align-items: flex-start;
  gap: 0.875rem;
  padding: 0.875rem 0;
  border-bottom: 1px solid rgba(0,0,0,0.05);
  transition: var(--transition);
}
.trending-item:last-child { border-bottom: none; }
.trending-item:hover .trending-title { color: var(--indigo-400); }
.trending-num { font-family: var(--font-display); font-size: 1.1rem; font-weight: 800; color: rgba(0,0,0,0.1); min-width: 2rem; }
.trending-title { font-size: 0.86rem; font-weight: 500; color: var(--white); line-height: 1.4; margin-bottom: 0.3rem; transition: var(--transition); }
.trending-meta { display: flex; align-items: center; gap: 0.25rem; }

.sidebar-cats { display: flex; flex-direction: column; gap: 0.25rem; }
.sidebar-cat {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.5rem 0.6rem;
  border-radius: var(--radius-sm);
  transition: var(--transition);
  color: var(--gray-300);
  font-size: 0.875rem;
}
.sidebar-cat:hover { background: rgba(0,0,0,0.05); color: var(--white); }
.sidebar-cat-icon { width: 30px; height: 30px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; font-size: 0.9rem; flex-shrink: 0; }
.sidebar-cat-name { flex: 1; font-weight: 500; }
.sidebar-cat-count { font-size: 0.75rem; color: var(--gray-600); }

@media (max-width: 1100px) {
  .home-layout { grid-template-columns: 1fr; }
  .sidebar { position: static; }
}
</style>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
