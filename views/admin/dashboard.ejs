<% locals.adminPage = 'dashboard'; %>
<%- include('../partials/admin-head') %>

<!-- Stats Row -->
<div class="dash-stats">
  <div class="dash-stat-card">
    <div class="dash-stat-icon" style="background:rgba(99,102,241,0.15);color:var(--indigo)">📰</div>
    <div class="dash-stat-body">
      <div class="dash-stat-num"><%= stats.totalArticles %></div>
      <div class="dash-stat-label">Total Articles</div>
      <div class="dash-stat-sub"><%= stats.published %> published · <%= stats.drafts %> drafts</div>
    </div>
  </div>
  <div class="dash-stat-card">
    <div class="dash-stat-icon" style="background:rgba(16,185,129,0.15);color:var(--emerald)">👁</div>
    <div class="dash-stat-body">
      <div class="dash-stat-num"><%= stats.totalViews?.toLocaleString() || 0 %></div>
      <div class="dash-stat-label">Total Views</div>
      <div class="dash-stat-sub">Across all articles</div>
    </div>
  </div>
  <div class="dash-stat-card">
    <div class="dash-stat-icon" style="background:rgba(245,158,11,0.15);color:var(--amber)">🎯</div>
    <div class="dash-stat-body">
      <div class="dash-stat-num"><%= stats.leads %></div>
      <div class="dash-stat-label">Total Leads</div>
      <div class="dash-stat-sub"><span style="color:var(--rose)"><%= stats.newLeads %> new</span> · <%= stats.leads - stats.newLeads %> reviewed</div>
    </div>
  </div>
  <div class="dash-stat-card">
    <div class="dash-stat-icon" style="background:rgba(239,68,68,0.15);color:var(--rose)">📬</div>
    <div class="dash-stat-body">
      <div class="dash-stat-num"><%= stats.subscribers %></div>
      <div class="dash-stat-label">Newsletter Subs</div>
      <div class="dash-stat-sub"><%= stats.comments %> comments pending</div>
    </div>
  </div>
</div>

<!-- Quick Actions -->
<div class="dash-quick-actions">
  <a href="/admin/articles/new" class="quick-action-btn">✏️ Write Article</a>
  <a href="/admin/media" class="quick-action-btn">🖼️ Upload Image</a>
  <a href="/admin/categories" class="quick-action-btn">🏷️ Categories</a>
  <a href="/admin/leads" class="quick-action-btn">🎯 View Leads</a>
  <a href="/admin/comments" class="quick-action-btn">💬 Comments</a>
  <a href="/admin/settings" class="quick-action-btn">⚙️ Settings</a>
</div>

<!-- Main Dashboard Grid -->
<div class="dash-grid">
  <!-- Recent Articles -->
  <div class="dash-panel">
    <div class="dash-panel-header">
      <h3 class="dash-panel-title">Recent Articles</h3>
      <a href="/admin/articles" class="dash-panel-link">View All →</a>
    </div>
    <div class="dash-table-wrap">
      <table class="dash-table">
        <thead><tr><th>Title</th><th>Category</th><th>Status</th><th>Views</th><th>Actions</th></tr></thead>
        <tbody>
          <% recentArticles.forEach(article => { %>
          <tr>
            <td>
              <a href="/admin/articles/<%= article.id %>/edit" class="dash-article-title"><%= article.title.substring(0,50) %><%= article.title.length > 50 ? '...' : '' %></a>
            </td>
            <td>
              <% if (article.category_name) { %>
              <span class="admin-cat-badge" style="background:<%= article.category_color %>22;color:<%= article.category_color %>"><%= article.category_name %></span>
              <% } else { %><span style="color:var(--gray-600)">—</span><% } %>
            </td>
            <td><span class="admin-status-badge admin-status-<%= article.status %>"><%= article.status %></span></td>
            <td><%= (article.views||0).toLocaleString() %></td>
            <td class="dash-actions-cell">
              <a href="/admin/articles/<%= article.id %>/edit" class="admin-action-btn">Edit</a>
              <a href="/article/<%= article.slug %>" target="_blank" class="admin-action-btn">View</a>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Right Column -->
  <div style="display:flex;flex-direction:column;gap:1.5rem;">

    <!-- Top Articles by Views -->
    <div class="dash-panel">
      <div class="dash-panel-header">
        <h3 class="dash-panel-title">🔥 Top Articles</h3>
      </div>
      <div style="display:flex;flex-direction:column;gap:0;">
        <% topArticles.forEach((a, i) => { %>
        <div style="display:flex;align-items:center;gap:0.875rem;padding:0.75rem 0;border-bottom:1px solid rgba(255,255,255,0.05);">
          <span style="font-family:var(--font-display);font-size:1rem;font-weight:800;color:rgba(255,255,255,0.15);min-width:1.75rem;"><%= String(i+1).padStart(2,'0') %></span>
          <div style="flex:1;">
            <a href="/admin/articles/<%= a.id %>/edit" style="font-size:0.85rem;font-weight:500;color:var(--white);display:block;line-height:1.3;"><%= a.title.substring(0,50) %><%= a.title.length>50?'...':'' %></a>
          </div>
          <span style="font-size:0.8rem;color:var(--indigo-400);font-weight:600;white-space:nowrap;">👁 <%= (a.views||0).toLocaleString() %></span>
        </div>
        <% }); %>
      </div>
    </div>

    <!-- Recent Leads -->
    <div class="dash-panel">
      <div class="dash-panel-header">
        <h3 class="dash-panel-title">🎯 Recent Leads</h3>
        <a href="/admin/leads" class="dash-panel-link">View All →</a>
      </div>
      <% if (recentLeads.length === 0) { %>
      <p style="color:var(--gray-500);font-size:0.875rem;padding:0.5rem 0;">No leads yet.</p>
      <% } %>
      <div style="display:flex;flex-direction:column;gap:0.75rem;">
        <% recentLeads.forEach(lead => { %>
        <div style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);border-radius:var(--radius-md);padding:0.875rem;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.3rem;">
            <span style="font-size:0.875rem;font-weight:600;color:var(--white);"><%= lead.name %></span>
            <span class="admin-status-badge admin-status-<%= lead.status %>"><%= lead.status %></span>
          </div>
          <div style="font-size:0.78rem;color:var(--gray-500);"><%= lead.email %> · <%= lead.service_type || 'General' %></div>
          <div style="font-size:0.78rem;color:var(--gray-600);margin-top:0.25rem;"><%= new Date(lead.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %></div>
        </div>
        <% }); %>
      </div>
    </div>

    <!-- Categories Overview -->
    <div class="dash-panel">
      <div class="dash-panel-header">
        <h3 class="dash-panel-title">Categories</h3>
        <a href="/admin/categories" class="dash-panel-link">Manage →</a>
      </div>
      <div style="display:flex;flex-direction:column;gap:0.4rem;">
        <% categories.slice(0,6).forEach(cat => { %>
        <div style="display:flex;align-items:center;gap:0.75rem;padding:0.4rem 0.5rem;border-radius:var(--radius-sm);">
          <span style="width:28px;height:28px;background:<%= cat.color %>22;color:<%= cat.color %>;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:0.8rem;flex-shrink:0;"><%= cat.icon %></span>
          <span style="flex:1;font-size:0.85rem;color:var(--gray-300);"><%= cat.name %></span>
          <span style="font-size:0.78rem;color:var(--gray-500);"><%= cat.article_count||0 %></span>
        </div>
        <% }); %>
      </div>
    </div>

  </div>
</div>

<style>
.dash-stats { display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.5rem; }
.dash-stat-card { background:var(--admin-card);border:1px solid var(--admin-border);border-radius:var(--radius-lg);padding:1.25rem;display:flex;align-items:center;gap:1rem; }
.dash-stat-icon { width:48px;height:48px;border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;font-size:1.25rem;flex-shrink:0; }
.dash-stat-num { font-family:var(--font-display);font-size:1.6rem;font-weight:800;color:var(--white);line-height:1; }
.dash-stat-label { font-size:0.8rem;color:var(--gray-400);font-weight:600;margin-top:0.2rem; }
.dash-stat-sub { font-size:0.72rem;color:var(--gray-600);margin-top:0.15rem; }
.dash-quick-actions { display:flex;gap:0.75rem;flex-wrap:wrap;margin-bottom:1.5rem; }
.quick-action-btn { padding:0.5rem 1rem;background:var(--admin-card);border:1px solid var(--admin-border);border-radius:var(--radius-md);font-size:0.82rem;font-weight:600;color:var(--gray-300);transition:var(--transition);cursor:pointer; }
.quick-action-btn:hover { background:rgba(99,102,241,0.12);border-color:rgba(99,102,241,0.3);color:var(--indigo-400); }
.dash-grid { display:grid;grid-template-columns:1fr 340px;gap:1.5rem; }
.dash-panel { background:var(--admin-card);border:1px solid var(--admin-border);border-radius:var(--radius-lg);padding:1.25rem; }
.dash-panel-header { display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem; }
.dash-panel-title { font-family:var(--font-display);font-size:0.95rem;font-weight:700;color:var(--white); }
.dash-panel-link { font-size:0.78rem;color:var(--indigo-400);font-weight:600;transition:var(--transition); }
.dash-panel-link:hover { color:var(--indigo); }
.dash-table-wrap { overflow-x:auto; }
.dash-table { width:100%;border-collapse:collapse;font-size:0.82rem; }
.dash-table th { padding:0.5rem 0.75rem;text-align:left;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:var(--gray-500);border-bottom:1px solid var(--admin-border); }
.dash-table td { padding:0.625rem 0.75rem;border-bottom:1px solid rgba(255,255,255,0.04);vertical-align:middle; }
.dash-table tr:last-child td { border-bottom:none; }
.dash-article-title { color:var(--gray-200);font-weight:500;font-size:0.85rem;transition:var(--transition); }
.dash-article-title:hover { color:var(--indigo-400); }
.dash-actions-cell { display:flex;gap:0.4rem; }
@media(max-width:1200px){.dash-stats{grid-template-columns:1fr 1fr}}
@media(max-width:900px){.dash-grid{grid-template-columns:1fr}}
@media(max-width:600px){.dash-stats{grid-template-columns:1fr}}
</style>

<%- include('../partials/admin-foot') %>
