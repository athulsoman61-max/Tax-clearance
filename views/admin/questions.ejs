<% locals.adminPage = 'questions'; %>
<%- include('../partials/admin-head') %>

<div style="flex: 1; padding: 2rem; overflow-y: auto;">
  <div style="max-width: 1200px; margin: 0 auto;">
    
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
      <div>
        <h1 style="font-family: var(--font-display); font-size: 2rem; color: var(--white); margin: 0;">Community Questions</h1>
        <p style="color: var(--gray-400); margin-top: 0.5rem;">Manage and answer questions from the community (Total: <%= total %>)</p>
      </div>
      <a href="/questions/new" target="_blank" class="btn btn-primary btn-sm">+ Post Question</a>
    </div>

    <div style="background: var(--navy-800); border-radius: var(--radius-lg); border: 1px solid rgba(255,255,255,0.05); overflow: hidden;">
      <table style="width: 100%; border-collapse: collapse; color: var(--gray-300);">
        <thead>
          <tr style="background: rgba(0,0,0,0.2); border-bottom: 1px solid rgba(255,255,255,0.05); text-align: left;">
            <th style="padding: 1rem 1.5rem; font-weight: 600; color: var(--white);">Title</th>
            <th style="padding: 1rem 1.5rem; font-weight: 600; color: var(--white);">Category</th>
            <th style="padding: 1rem 1.5rem; font-weight: 600; color: var(--white);">Author</th>
            <th style="padding: 1rem 1.5rem; font-weight: 600; color: var(--white);">Answers</th>
            <th style="padding: 1rem 1.5rem; font-weight: 600; color: var(--white);">Date</th>
            <th style="padding: 1rem 1.5rem; font-weight: 600; color: var(--white); text-align: right;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (questions.length > 0) { %>
            <% questions.forEach(q => { %>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.02); transition: background 0.2s;">
                <td style="padding: 1rem 1.5rem; font-weight: 500; color: var(--white);">
                  <a href="/question/<%= q.id %>" target="_blank" style="color: var(--white); text-decoration: none;"><%= q.title %></a>
                </td>
                <td style="padding: 1rem 1.5rem;"><%= q.category_name || 'General' %></td>
                <td style="padding: 1rem 1.5rem;"><%= q.author_name || 'Anonymous' %></td>
                <td style="padding: 1rem 1.5rem;">
                  <span style="background: rgba(99,102,241,0.15); color: var(--indigo-300); padding: 0.2rem 0.6rem; border-radius: 12px; font-size: 0.8rem;">
                    <%= q.answer_count %> Answer<%= q.answer_count !== 1 ? 's' : '' %>
                  </span>
                </td>
                <td style="padding: 1rem 1.5rem; font-size: 0.9rem; color: var(--gray-400);">
                  <%= new Date(q.created_at).toLocaleDateString() %>
                </td>
                <td style="padding: 1rem 1.5rem; text-align: right; display: flex; gap: 0.5rem; justify-content: flex-end;">
                  <a href="/question/<%= q.id %>" target="_blank" class="btn btn-sm" style="background: rgba(255,255,255,0.1); color: var(--white);">View & Reply</a>
                  <form action="/question/<%= q.id %>/delete" method="POST" onsubmit="return confirm('Delete this question permanently?');" style="margin:0;">
                    <button type="submit" class="btn btn-sm" style="background: rgba(239,68,68,0.1); color: var(--rose); border: 1px solid rgba(239,68,68,0.2);">Delete</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" style="padding: 2rem; text-align: center; color: var(--gray-500);">No community questions yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <div style="padding: 1rem 1.5rem; border-top: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: space-between; align-items: center;">
          <div style="color: var(--gray-400); font-size: 0.9rem;">
            Showing page <%= currentPage %> of <%= totalPages %>
          </div>
          <div style="display: flex; gap: 0.5rem;">
            <% if (currentPage > 1) { %>
              <a href="?page=<%= currentPage - 1 %>" class="btn btn-outline" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">Previous</a>
            <% } %>
            <% if (currentPage < totalPages) { %>
              <a href="?page=<%= currentPage + 1 %>" class="btn btn-outline" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">Next</a>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>

  </div>
</div>

<%- include('../partials/admin-foot') %>
