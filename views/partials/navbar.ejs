<% const siteName = settings?.site_name || 'Tax Clearance'; %>
<nav class="navbar" id="navbar">
  <div class="nav-inner">
    <a href="/" class="nav-logo" style="text-decoration: none;">
      <div class="nav-logo-icon" style="background: var(--navy-800); border: 1px solid var(--indigo-400); color: var(--indigo-400); border-radius: 8px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <span class="nav-logo-text" style="font-size: 1.3rem; font-family: var(--font-display); letter-spacing: -0.5px;">
        <span style="color: var(--white); font-weight: 800;">Tax</span><span style="color: var(--indigo-400); font-weight: 800;">Clearance</span><span style="color: var(--gray-500); font-size: 0.75em; font-weight: 600;">.space</span>
      </span>
    </a>
    <div class="nav-links">
      <a href="/" class="<%= locals.page === 'home' ? 'active' : '' %>">Home</a>
      <a href="/category/tax-deductions">Articles</a>
      <a href="/community">Community</a>
      <a href="/experts">Experts</a>
      <a href="/about" class="<%= locals.page === 'about' ? 'active' : '' %>">About EA</a>
    </div>
    <div class="nav-right">
      <button class="nav-search-btn" id="searchBtn" aria-label="Search">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </button>
      
      <% if (locals.user) { %>
        <a href="/questions/new" class="btn-ea">Ask Question</a>
        <a href="/logout" style="color: var(--gray-300); font-size: 0.85rem; font-weight: 500; margin-left: 0.5rem;">Logout</a>
      <% } else { %>
        <a href="/login" style="color: var(--gray-300); font-size: 0.85rem; font-weight: 500; margin-right: 0.5rem;">Log In</a>
        <a href="/register" class="btn-ea" style="background: var(--navy-600); box-shadow: none;">Sign Up</a>
      <% } %>
      
      <button class="nav-toggle" id="navToggle" aria-label="Menu">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</nav>
<div class="mobile-menu" id="mobileMenu">
  <a href="/">🏠 Home</a>
  <a href="/category/tax-deductions">📚 Articles</a>
  <a href="/community">👥 Community</a>
  <a href="/experts">⭐ Experts</a>
  <a href="/about">👤 About</a>
  <% if (locals.user) { %>
    <a href="/logout" style="color:var(--rose);">🚪 Logout</a>
  <% } else { %>
    <a href="/login" style="color:var(--indigo-400);">🔑 Log In / Sign Up</a>
  <% } %>
</div>
<div class="search-overlay" id="searchOverlay">
  <div class="search-overlay-inner">
    <div class="search-overlay-input-wrap">
      <input type="text" class="search-overlay-input" id="searchInput" placeholder="Search tax topics, IRS updates, deductions..." autocomplete="off">
      <button class="search-close" id="searchClose" aria-label="Close">✕</button>
    </div>
    <div class="search-results-live" id="searchResultsLive" style="display:none;"></div>
  </div>
</div>
