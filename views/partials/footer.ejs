<% const siteName = settings?.site_name || 'Tax Clearance'; %>
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="nav-logo" style="margin-bottom:1rem;display:inline-flex">
          <div class="nav-logo-icon">⚖️</div>
          <span><%= siteName %></span>
        </a>
        <p class="footer-desc"><%= settings?.site_description || 'Free US tax education by a licensed Enrolled Agent.' %></p>
        <div class="footer-social">
          <% if (settings?.twitter_handle) { %><a href="https://twitter.com/<%= settings.twitter_handle.replace('@','') %>" target="_blank" rel="noopener" aria-label="Twitter">𝕏</a><% } %>
          <% if (settings?.facebook_url) { %><a href="<%= settings.facebook_url %>" target="_blank" rel="noopener" aria-label="Facebook">f</a><% } %>
          <% if (settings?.linkedin_url) { %><a href="<%= settings.linkedin_url %>" target="_blank" rel="noopener" aria-label="LinkedIn">in</a><% } %>
        </div>
      </div>
      <div>
        <div class="footer-col-title">Categories</div>
        <div class="footer-links">
          <a href="/category/tax-deductions">💰 Tax Deductions</a>
          <a href="/category/tax-credits">✅ Tax Credits</a>
          <a href="/category/irs-updates">📢 IRS Updates</a>
          <a href="/category/small-business-taxes">🏢 Small Business</a>
          <a href="/category/self-employed-taxes">💼 Self-Employed</a>
          <a href="/category/crypto-tax">₿ Crypto Tax</a>
        </div>
      </div>
      <div>
        <div class="footer-col-title">More Topics</div>
        <div class="footer-links">
          <a href="/category/tax-planning">📊 Tax Planning</a>
          <a href="/category/international-tax">🌍 International Tax</a>
          <a href="/category/state-taxes">🗺️ State Taxes</a>
          <a href="/category/tax-filing-tips">📝 Filing Tips</a>
          <a href="/category/tax-deadlines">📅 Deadlines</a>
          <a href="/category/tax-relief-programs">🛡️ Tax Relief</a>
        </div>
      </div>
      <div>
        <div class="footer-col-title">Enrolled Agent</div>
        <div class="footer-links">
          <a href="/about">About the EA</a>
          <a href="/contact">Book Consultation</a>
          <a href="/sitemap.xml" target="_blank">Sitemap</a>
        </div>
        <div style="margin-top:1.25rem">
          <div class="footer-col-title">Free Newsletter</div>
          <form class="newsletter-form" id="footerNewsletter" style="flex-direction:column;max-width:100%">
            <input type="email" class="newsletter-input" placeholder="your@email.com" name="email" required>
            <button type="submit" class="btn btn-primary btn-sm" style="margin-top:0.5rem">Subscribe Free</button>
          </form>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-copy"><%= settings?.footer_text || `© ${new Date().getFullYear()} ${siteName}. All rights reserved.` %></div>
      <div class="footer-disclaimer">Educational content only — not legal or financial advice.</div>
    </div>
  </div>
</footer>
<!-- Mobile Bottom Navigation Bar -->
<style>
  .mobile-bottom-nav {
    display: none; /* hidden on desktop */
  }
  @media (max-width: 768px) {
    /* Add padding to body so content isn't covered */
    body { padding-bottom: 70px; }
    
    .mobile-bottom-nav {
      display: flex;
      justify-content: space-around;
      align-items: center;
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      background: rgba(15, 23, 42, 0.95); /* var(--navy-900) with transparency */
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      z-index: 1000;
      height: 65px;
      padding-bottom: env(safe-area-inset-bottom); /* iOS safe area */
    }
    .mobile-nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      color: var(--gray-400);
      font-size: 0.7rem;
      font-weight: 500;
      gap: 0.2rem;
      flex: 1;
      height: 100%;
    }
    .mobile-nav-item.active {
      color: var(--white);
    }
    .mobile-nav-item svg {
      width: 24px;
      height: 24px;
      stroke-width: 1.5;
    }
    .mobile-nav-item.active svg {
      stroke: var(--white);
      fill: rgba(255, 255, 255, 0.1);
    }
    
    /* Prominent Community Button */
    .mobile-nav-community {
      position: relative;
      top: -15px;
      background: linear-gradient(135deg, var(--indigo-400), var(--indigo));
      width: 55px;
      height: 55px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
      color: white;
      border: 4px solid var(--navy-900);
    }
    .mobile-nav-community svg {
      width: 26px;
      height: 26px;
      stroke: white;
      fill: none;
    }
    .mobile-nav-community-label {
      position: absolute;
      bottom: -16px;
      font-size: 0.7rem;
      color: var(--gray-300);
      white-space: nowrap;
    }
  }
</style>

<nav class="mobile-bottom-nav">
  <a href="/" class="mobile-nav-item <%= locals.page === 'home' ? 'active' : '' %>">
    <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
    Home
  </a>
  
  <a href="/articles" class="mobile-nav-item <%= locals.page === 'articles' ? 'active' : '' %>">
    <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10l6 6v10a2 2 0 01-2 2z"></path><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"></path></svg>
    Articles
  </a>
  
  <a href="/community" class="mobile-nav-item <%= locals.page === 'community' ? 'active' : '' %>" style="flex: 1; display: flex; flex-direction: column; align-items: center; text-decoration: none;">
    <div class="mobile-nav-community">
      <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path></svg>
    </div>
    <span class="mobile-nav-community-label">Community</span>
  </a>
  
  <a href="/search" class="mobile-nav-item <%= locals.page === 'search' ? 'active' : '' %>">
    <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    Search
  </a>
</nav>

<div class="toast-container" id="toastContainer"></div>
<script src="/js/main.js"></script>
