<%
const gaId = settings?.google_analytics_id || '';
const siteName = settings?.site_name || 'Tax Clearance';
const siteUrl = locals.siteUrl || process.env.SITE_URL || 'https://www.taxclearance.space';
const canonicalUrl = locals.canonical_url || (siteUrl + (locals.req ? locals.req.path : '/'));
const ogImg = (locals.article?.og_image || locals.article?.featured_image || '');
const pageTitle = locals.title || siteName;
const pageDesc = locals.description || settings?.site_description || '';
%><!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="0MT_rBdOISOCy88ZH0N9PsBhiZn0-9jsD2xgKVsy9PM" />
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <% if (locals.article?.seo_keywords) { %><meta name="keywords" content="<%= locals.article.seo_keywords %>"><% } %>
  <link rel="canonical" href="<%= canonicalUrl %>">

  <!-- Open Graph -->
  <meta property="og:type" content="<%= locals.article ? 'article' : 'website' %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <% if (ogImg) { %><meta property="og:image" content="<%= siteUrl %><%= ogImg %>"><% } %>
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:site_name" content="<%= siteName %>">
  <% if (locals.article) { %>
  <meta property="article:published_time" content="<%= new Date(locals.article.publish_date || locals.article.created_at).toISOString() %>">
  <% if (locals.article.updated_at) { %><meta property="article:modified_time" content="<%= new Date(locals.article.updated_at).toISOString() %>"><% } %>
  <% if (locals.article.author_name) { %><meta property="article:author" content="<%= locals.article.author_name %>"><% } %>
  <% } %>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= pageDesc %>">
  <% if (ogImg) { %><meta name="twitter:image" content="<%= siteUrl %><%= ogImg %>"><% } %>

  <!-- Styles -->
  <link rel="stylesheet" href="/css/main.css?v=3">
</head>
<body>
