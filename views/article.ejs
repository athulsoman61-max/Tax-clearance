/* Comments */
.comments-section { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid rgba(0,0,0,0.07); }
.comments-title { font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; }
.comment-success-msg { background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.25); border-radius: var(--radius-md); padding: 0.875rem 1rem; font-size: 0.875rem; color: var(--emerald); margin-bottom: 1rem; }

