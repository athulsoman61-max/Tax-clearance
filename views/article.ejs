<%- include('partials/head') %>
<%- include('partials/navbar') %>

<% if (locals.isPreview) { %>
<div style="position:fixed;top:var(--nav-height);left:0;right:0;z-index:100;background:var(--amber);color:var(--navy);padding:0.5rem;text-align:center;font-weight:700;font-size:0.85rem;">
  ⚠️ PREVIEW MODE — This article is not yet published
  <a href="/admin/articles/<%= article.id %>/edit" style="margin-left:1rem;text-decoration:underline">Edit Article</a>
</div>
<% } %>

<!-- JSON-LD Article Schema for Google Rich Snippets -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "<%= article.seo_title || article.title %>",
  "image": "<%= article.featured_image ? (locals.siteUrl || process.env.SITE_URL || 'https://www.taxclearance.space') + article.featured_image : '' %>",
  "author": {
    "@type": "Person",
    "name": "<%= article.author_name || 'Tax Clearance EA' %>"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Tax Clearance",
    "logo": {
      "@type": "ImageObject",
      "url": "<%= (locals.siteUrl || process.env.SITE_URL || 'https://www.taxclearance.space') %>/img/logo.png"
    }
  },
  "datePublished": "<%= new Date(article.publish_date || article.created_at).toISOString() %>",
  "dateModified": "<%= new Date(article.updated_at || article.created_at).toISOString() %>",
  "description": "<%= article.seo_description || article.excerpt %>"
}
</script>

<!-- JSON-LD Breadcrumb Schema for Google Rich Snippets -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "<%= (locals.siteUrl || process.env.SITE_URL || 'https://www.taxclearance.space') %>"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "<%= article.category_name || 'Tax Articles' %>",
      "item": "<%= (locals.siteUrl || process.env.SITE_URL || 'https://www.taxclearance.space') %>/category/<%= article.category_slug || 'articles' %>"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "<%= article.seo_title || article.title %>"
    }
  ]
}
</script>

<!-- Reading Progress Bar -->
<div class="reading-progress" id="readingProgress"></div>

<!-- Article Hero -->
<div class="article-hero">
  <% if (article.featured_image) { %>
  <div class="article-hero-img-wrap">
    <% const heroImgPath = article.featured_image.startsWith('/') || article.featured_image.startsWith('http') ? article.featured_image : '/images/' + article.featured_image; %>
    <img src="<%= heroImgPath %>" alt="<%= article.featured_image_alt || article.title %>" class="article-hero-img" loading="eager">
    <div class="article-hero-overlay"></div>
  </div>
  <% } %>
  <div class="article-hero-content container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <% if (article.category_slug) { %>
      <a href="/category/<%= article.category_slug %>"><%= article.category_name %></a>
      <span>›</span>
      <% } %>
      <span><%= article.title.substring(0, 40) %>...</span>
    </nav>
    <div class="article-meta-top">
      <% if (article.category_name) { %>
      <a href="/category/<%= article.category_slug %>" class="badge" style="background:<%= article.category_color %>22;color:<%= article.category_color %>;border:1px solid <%= article.category_color %>44">
        <%= article.category_icon %> <%= article.category_name %>
      </a>
      <% } %>
    </div>
    <h1 class="article-title"><%= article.title %></h1>
    <p class="article-excerpt"><%= article.excerpt %></p>
    <div class="article-byline">
      <div class="article-author-chip">
        <div class="author-chip-avatar">⚖️</div>
        <div>
          <div class="author-chip-name"><%= article.author_name || 'Tax Clearance EA' %></div>
          <div class="author-chip-cred">Enrolled Agent (EA)</div>
        </div>
      </div>
      <div class="article-byline-meta">
        <span>📅 <%= new Date(article.publish_date || article.created_at).toLocaleDateString('en-US', {month:'long', day:'numeric', year:'numeric'}) %></span>
        <span>⏱ <%= article.reading_time %> min read</span>
        <span>👁 <%= (article.views || 0).toLocaleString() %> views</span>
      </div>
    </div>
  </div>
</div>

<!-- Article Body Layout -->
<div class="container article-layout" style="margin-top: 2.5rem; padding-bottom: 4rem;">

  <!-- Sticky Share Bar (left) -->
  <div class="share-bar">
    <div class="share-bar-inner" id="shareBar">
      <span class="share-bar-label">Share</span>
      <a href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent((locals.siteUrl||'') + '/article/' + article.slug) %>&text=<%= encodeURIComponent(article.title) %>&via=TaxClearance" target="_blank" rel="noopener" class="share-btn share-twitter" aria-label="Share on Twitter">𝕏</a>
      <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent((locals.siteUrl||'') + '/article/' + article.slug) %>" target="_blank" rel="noopener" class="share-btn share-fb" aria-label="Share on Facebook">f</a>
      <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent((locals.siteUrl||'') + '/article/' + article.slug) %>" target="_blank" rel="noopener" class="share-btn share-li" aria-label="Share on LinkedIn">in</a>
      <button class="share-btn share-copy" onclick="copyLink()" aria-label="Copy link">🔗</button>
    </div>
  </div>

  <!-- Main Article Content -->
  <article class="article-main">

    <!-- Hub Navigation Banner -->
    <% if (locals.hubContext && locals.hubArticles) { %>
      <% 
        const currentIdx = hubArticles.findIndex(a => a.slug === article.slug);
        const prevArticle = currentIdx > 0 ? hubArticles[currentIdx - 1] : null;
        const nextArticle = currentIdx < hubArticles.length - 1 ? hubArticles[currentIdx + 1] : null;
      %>
      <div style="background:var(--indigo-50); border:1px solid var(--indigo-100); border-radius:var(--radius-lg); padding:1.5rem; margin-bottom:2rem;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
          <div>
            <div style="font-size:0.85rem; font-weight:600; color:var(--indigo-600); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.25rem;">Part of the Guide</div>
            <h3 style="margin:0; font-family:var(--font-display); font-size:1.25rem; color:var(--gray-900);"><a href="/education/<%= hubContext.hub_slug %>" style="color:inherit; text-decoration:none;"><%= hubContext.hub_title %></a></h3>
          </div>
          <a href="/education/<%= hubContext.hub_slug %>" class="btn btn-secondary" style="font-size:0.85rem; padding:0.4rem 0.75rem;">View Full Guide</a>
        </div>
        
        <div style="display:flex; gap:1rem; border-top:1px solid var(--indigo-100); padding-top:1rem; margin-top:0.5rem;">
          <% if (prevArticle) { %>
            <a href="/article/<%= prevArticle.slug %>" style="flex:1; display:flex; flex-direction:column; text-decoration:none; color:var(--gray-700); padding:0.75rem; background:var(--white); border-radius:var(--radius-md); border:1px solid var(--gray-200); transition:border-color 0.2s;" onmouseover="this.style.borderColor='var(--indigo-300)'" onmouseout="this.style.borderColor='var(--gray-200)'">
              <span style="font-size:0.8rem; color:var(--gray-500); margin-bottom:0.25rem;">← Previous Chapter</span>
              <span style="font-weight:500; font-size:0.95rem; line-height:1.3;"><%= prevArticle.title %></span>
            </a>
          <% } else { %>
            <div style="flex:1;"></div>
          <% } %>
          
          <% if (nextArticle) { %>
            <a href="/article/<%= nextArticle.slug %>" style="flex:1; display:flex; flex-direction:column; text-align:right; text-decoration:none; color:var(--gray-700); padding:0.75rem; background:var(--white); border-radius:var(--radius-md); border:1px solid var(--gray-200); transition:border-color 0.2s;" onmouseover="this.style.borderColor='var(--indigo-300)'" onmouseout="this.style.borderColor='var(--gray-200)'">
              <span style="font-size:0.8rem; color:var(--gray-500); margin-bottom:0.25rem;">Next Chapter →</span>
              <span style="font-weight:500; font-size:0.95rem; line-height:1.3;"><%= nextArticle.title %></span>
            </a>
          <% } else { %>
            <div style="flex:1;"></div>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- Table of Contents (auto-generated) -->
    <div class="toc-box" id="tocBox">
      <div class="toc-header">
        <span>📋</span>
        <strong>Table of Contents</strong>
        <button class="toc-toggle" id="tocToggle">−</button>
      </div>
      <nav class="toc-nav" id="tocNav"></nav>
    </div>

    <!-- Article Body -->
    <div class="article-body" id="articleBody">
      <%- article.content %>
    </div>

    <!-- Tags -->
    <% if (tags && tags.length > 0) { %>
    <div class="article-tags">
      <span class="tags-label">Tags:</span>
      <% tags.forEach(tag => { %>
      <a href="/search?q=<%= tag.slug %>" class="tag-pill">#<%= tag.name %></a>
      <% }); %>
    </div>
    <% } %>

    <!-- EA CTA Box -->
    <div class="article-ea-cta">
      <div class="ea-cta-icon">⚖️</div>
      <div class="ea-cta-body">
        <h3>Have Questions About Your Taxes?</h3>
        <p>As an <strong>Enrolled Agent (EA)</strong> licensed by the IRS, I can help you apply these concepts to your specific situation. Book a free initial consultation — no obligation.</p>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;margin-top:1rem;">
          <a href="/contact" class="btn btn-primary">📅 Book Consultation</a>
          <a href="/contact#ask" class="btn btn-outline">💬 Ask a Question</a>
        </div>
      </div>
    </div>

    <!-- Author Bio -->
    <div class="author-bio-box">
      <div class="author-bio-avatar">⚖️</div>
      <div class="author-bio-content">
        <div class="author-bio-name"><%= article.author_name || 'Tax Clearance EA' %></div>
        <div class="author-bio-cred">Enrolled Agent (EA) — IRS Authorized Tax Professional</div>
        <p class="author-bio-text"><%= article.author_bio || settings?.ea_bio || 'Dedicated to providing free, high-quality US tax education to help individuals and small businesses navigate the tax system with confidence.' %></p>
        <a href="/about" class="btn btn-ghost btn-sm">View Full Profile →</a>
      </div>
    </div>

    <!-- Comments Section -->
    <div class="comments-section" id="comments">
      <h2 class="comments-title">Comments (<%= comments.length %>)</h2>

      <% if (locals.query && locals.query.commented) { %>
      <div class="comment-success-msg">✅ Your comment was submitted and is pending moderation. Thank you!</div>
      <% } %>

      <% if (comments.length > 0) { %>
      <div class="comments-list">
        <% comments.forEach(comment => { %>
        <div class="comment-item">
          <div class="comment-avatar"><%= comment.author_name.charAt(0).toUpperCase() %></div>
          <div class="comment-body">
            <div class="comment-header">
              <span class="comment-author"><%= comment.author_name %></span>
              <span class="comment-date"><%= new Date(comment.created_at).toLocaleDateString('en-US', {month:'short',day:'numeric',year:'numeric'}) %></span>
            </div>
            <p class="comment-text"><%= comment.content %></p>
          </div>
        </div>
        <% }); %>
      </div>
      <% } else { %>
      <p style="color:var(--gray-500);font-size:0.875rem;">Be the first to leave a comment!</p>
      <% } %>

      <!-- Comment Form -->
      <div class="comment-form-wrap">
        <h3 class="comment-form-title">Leave a Comment</h3>
        <form action="/article/<%= article.slug %>/comment" method="POST" class="comment-form">
          <div class="form-row">
            <div class="form-group">
              <label>Name *</label>
              <input type="text" name="name" required class="form-input" placeholder="Your name">
            </div>
            <div class="form-group">
              <label>Email * <span style="color:var(--gray-600);font-size:0.75rem;">(not published)</span></label>
              <input type="email" name="email" required class="form-input" placeholder="your@email.com">
            </div>
          </div>
          <div class="form-group">
            <label>Comment *</label>
            <textarea name="content" required class="form-input" rows="4" placeholder="Share your thoughts or questions..."></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Post Comment →</button>
        </form>
      </div>
    </div>

  </article>

  <!-- Article Sidebar -->
  <aside class="article-sidebar">

    <!-- Related Articles -->
    <% if (related && related.length > 0) { %>
    <div class="sidebar-widget">
      <div class="section-title" style="font-size:1rem;margin-bottom:1rem;">
        <div class="section-title-accent"></div>
        Related Articles
      </div>
      <div style="display:flex;flex-direction:column;gap:1rem;">
        <% related.forEach(r => { %>
        <a href="/article/<%= r.slug %>" class="related-card">
          <% if (r.featured_image) { %>
          <% const relImgPath = r.featured_image.startsWith('/') || r.featured_image.startsWith('http') ? r.featured_image : '/images/' + r.featured_image; %>
          <img src="<%= relImgPath %>" alt="<%= r.title %>" class="related-card-img" loading="lazy">
          <% } %>
          <div class="related-card-body">
            <span class="article-card-cat" style="background:<%= r.category_color %>22;color:<%= r.category_color %>;font-size:0.68rem;padding:0.15rem 0.5rem"><%= r.category_name %></span>
            <div class="related-card-title"><%= r.title %></div>
            <div class="related-card-meta">⏱ <%= r.reading_time %> min</div>
          </div>
        </a>
        <% }); %>
      </div>
    </div>
    <% } %>

    <!-- Related Community Questions -->
    <% if (locals.relatedQuestions && relatedQuestions.length > 0) { %>
    <div class="sidebar-widget" style="border-left: 3px solid var(--indigo);">
      <div class="section-title" style="font-size:1rem;margin-bottom:1rem;">
        <div class="section-title-accent" style="background: var(--indigo);"></div>
        Community Questions
      </div>
      <div style="display:flex;flex-direction:column;gap:1rem;">
        <% relatedQuestions.forEach(q => { %>
        <a href="/question/<%= q.id %>" class="related-card" style="padding-left: 0;">
          <div class="related-card-body">
            <div style="display:flex; justify-content:space-between; margin-bottom: 0.25rem;">
              <span class="article-card-cat" style="background:<%= q.category_color %>22;color:<%= q.category_color %>;font-size:0.68rem;padding:0.15rem 0.5rem">❓ Question</span>
              <span style="font-size: 0.75rem; color: var(--gray-400);">💬 <%= q.answer_count %> answers</span>
            </div>
            <div class="related-card-title" style="font-size: 0.95rem; line-height: 1.4;"><%= q.title %></div>
          </div>
        </a>
        <% }); %>
      </div>
      <a href="/questions/new" class="btn btn-outline" style="width: 100%; margin-top: 1rem; font-size: 0.85rem;">Ask Your Own Question</a>
    </div>
    <% } %>

    <!-- EA Consult CTA -->
    <div class="sidebar-widget" style="background:linear-gradient(135deg,rgba(99,102,241,0.12),rgba(168,85,247,0.08));border-color:rgba(99,102,241,0.2);text-align:center;">
      <div style="font-size:2.5rem;margin-bottom:0.75rem;">⚖️</div>
      <h3 style="font-family:var(--font-display);font-size:1rem;font-weight:700;margin-bottom:0.5rem;">Get Professional Help</h3>
      <p style="font-size:0.82rem;color:var(--gray-400);margin-bottom:1rem;line-height:1.5;">Work directly with an <strong>Enrolled Agent</strong> for your specific tax situation.</p>
      <a href="/contact" class="btn btn-primary" style="width:100%;display:flex;">Book Free Consult →</a>
    </div>

    <!-- Categories -->
    <div class="sidebar-widget">
      <div class="section-title" style="font-size:1rem;margin-bottom:1rem;">
        <div class="section-title-accent"></div>
        Browse Topics
      </div>
      <div class="sidebar-cats">
        <% categories.slice(0, 8).forEach(cat => { %>
        <a href="/category/<%= cat.slug %>" class="sidebar-cat">
          <span class="sidebar-cat-icon" style="background:<%= cat.color %>22;color:<%= cat.color %>"><%= cat.icon %></span>
          <span class="sidebar-cat-name"><%= cat.name %></span>
          <span class="sidebar-cat-count"><%= cat.article_count || 0 %></span>
        </a>
        <% }); %>
      </div>
    </div>

  </aside>
</div>

<style>
.reading-progress {
  position: fixed;
  top: var(--nav-height);
  left: 0;
  height: 4px;
  background: var(--indigo-400);
  box-shadow: 0 0 15px var(--indigo), 0 0 5px var(--true-white);
  z-index: 999;
  width: 0%;
  transition: width 0.15s ease-out;
}

.article-hero {
  position: relative;
  overflow: hidden;
}

.article-hero-img-wrap {
  position: relative;
  width: 100%;
  height: 50vh;
  min-height: 400px;
}

.article-hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.article-hero-overlay { display: none; }

.article-hero-content {
  position: relative;
  z-index: 10;
  max-width: 900px;
  margin: -80px auto 0 auto;
  padding: 2.5rem;
  background: var(--true-white);
  border-radius: 32px 32px 0 0;
  box-shadow: 0 -10px 40px rgba(0,0,0,0.06);
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.78rem;
  color: var(--gray-500);
  margin-bottom: 1rem;
  flex-wrap: wrap;
}

.breadcrumb a { color: var(--gray-400); transition: var(--transition); }
.breadcrumb a:hover { color: var(--indigo-400); }

.article-meta-top { margin-bottom: 0.75rem; }

.article-title {
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 3.5vw, 2.6rem);
  font-weight: 800;
  line-height: 1.2;
  color: var(--navy);
  margin-bottom: 1rem;
}

.article-excerpt {
  font-size: 1.05rem;
  color: var(--gray-600);
  line-height: 1.7;
  margin-bottom: 1.25rem;
  max-width: 700px;
}

.article-byline {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.article-author-chip {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.author-chip-avatar {
  width: 38px; height: 38px;
  background: var(--gradient-accent);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 1rem;
}

.author-chip-name { font-size: 0.875rem; font-weight: 600; }
.author-chip-cred { font-size: 0.72rem; color: var(--indigo-400); }

.article-byline-meta {
  display: flex;
  align-items: center;
  gap: 1rem;
  font-size: 0.82rem;
  color: var(--gray-500);
  flex-wrap: wrap;
}

.article-layout {
  display: grid;
  grid-template-columns: 60px 1fr 300px;
  gap: 2rem;
  align-items: start;
}

/* Share bar */
.share-bar { position: sticky; top: calc(var(--nav-height) + 2rem); }
.share-bar-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6rem;
  background: var(--navy-700);
  border: 1px solid rgba(0,0,0,0.07);
  border-radius: var(--radius-lg);
  padding: 0.875rem 0.6rem;
}

.share-bar-label { font-size: 0.65rem; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.1em; }

.share-btn {
  width: 38px; height: 38px;
  border-radius: var(--radius-sm);
  display: flex; align-items: center; justify-content: center;
  font-size: 0.9rem;
  font-weight: 700;
  transition: var(--transition);
  color: var(--gray-400);
  background: rgba(0,0,0,0.04);
  border: 1px solid rgba(0,0,0,0.06);
  cursor: pointer;
  text-decoration: none;
}

.share-btn:hover { transform: scale(1.08); }
.share-twitter:hover { background: #1da1f2; color: white; border-color: #1da1f2; }
.share-fb:hover { background: #1877f2; color: white; border-color: #1877f2; }
.share-li:hover { background: #0077b5; color: white; border-color: #0077b5; }
.share-copy:hover { background: var(--emerald); border-color: var(--emerald); }

/* TOC */
.toc-box {
  background: rgba(99,102,241,0.06);
  border: 1px solid rgba(99,102,241,0.2);
  border-radius: var(--radius-lg);
  margin-bottom: 2rem;
  overflow: hidden;
}

.toc-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.875rem 1.25rem;
  border-bottom: 1px solid rgba(99,102,241,0.15);
  font-size: 0.875rem;
}

.toc-toggle {
  margin-left: auto;
  width: 24px; height: 24px;
  border-radius: 50%;
  background: rgba(0,0,0,0.06);
  color: var(--gray-400);
  font-size: 1rem;
  display: flex; align-items: center; justify-content: center;
  transition: var(--transition);
  cursor: pointer;
}

.toc-nav {
  padding: 0.875rem 1.25rem;
}

.toc-nav a {
  display: block;
  font-size: 0.82rem;
  color: var(--gray-400);
  padding: 0.25rem 0;
  border-left: 2px solid rgba(0,0,0,0.06);
  padding-left: 0.75rem;
  margin-bottom: 0.25rem;
  transition: var(--transition);
}

.toc-nav a.h3 { padding-left: 1.5rem; font-size: 0.78rem; }
.toc-nav a:hover, .toc-nav a.active { color: var(--indigo-400); border-left-color: var(--indigo); }

/* Article Body Typography */
.article-body {
  font-family: var(--font-serif);
  font-size: 1.05rem;
  line-height: 1.85;
  color: var(--gray-200);
}

.article-body h2 {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--white);
  margin: 2rem 0 1rem;
  padding-top: 1rem;
}

.article-body h3 {
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 600;
  color: var(--white);
  margin: 1.5rem 0 0.75rem;
}

.article-body p { margin-bottom: 1.25rem; }

.article-body a { color: var(--indigo-400); text-decoration: underline; text-decoration-color: rgba(99,102,241,0.4); }
.article-body a:hover { color: var(--indigo); }

.article-body strong { color: var(--white); font-weight: 700; }
.article-body em { color: var(--gray-300); }

.article-body blockquote {
  border-left: 4px solid var(--indigo);
