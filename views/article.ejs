.article-sidebar { position: sticky; top: calc(var(--nav-height) + 1.5rem); display: flex; flex-direction: column; gap: 1.5rem; }

@media (max-width: 1100px) {
  .article-layout { grid-template-columns: 1fr; }
  .share-bar { display: none; }
